# --- Supabase server-side (optional — omit all vars and the app runs on local seed data) ---
# Once these are set, src/lib/supabase.ts automatically switches from the
# seed JSON files to live Supabase queries. No code changes needed.
#
# SUPABASE_URL: your project's URL (safe to commit — it's public, e.g.
#   visible in any browser network tab once the app is live).
#   Example: https://your-project-ref.supabase.co
#
# SUPABASE_SECRET_KEY: the SECRET key (Project Settings -> API Keys),
#   Supabase's newer key format (sb_secret_...). This bypasses Row Level
#   Security and must NEVER be committed, NEVER prefixed with
#   NEXT_PUBLIC_, and NEVER referenced from any client component —
#   src/lib/supabaseClient.ts is marked "server-only" specifically to
#   make that a build-time error if it's ever imported client-side.
#
# SUPABASE_SERVICE_ROLE_KEY: legacy fallback name, only needed if your
#   project still uses the older long-JWT service_role key instead of
#   the newer sb_secret_... format. If SUPABASE_SECRET_KEY is set, this
#   is ignored.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase client-side (REQUIRED for admin login — see README "Admin authentication") ---
# These are intentionally PUBLIC (NEXT_PUBLIC_ prefix) — the anon/publishable
# key has no privileges beyond what Row Level Security grants (currently
# nothing at all on scholarships/universities/admin_users — see the
# migrations). It can only be used to sign a user in; it can never read or
# write scholarship data or the admin allowlist on its own.
#
# NEXT_PUBLIC_SUPABASE_URL: same value as SUPABASE_URL above.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: the PUBLISHABLE key (sb_publishable_...),
#   Project Settings -> API Keys. Legacy projects: use
#   NEXT_PUBLIC_SUPABASE_ANON_KEY instead (the old anon JWT) — either name works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Legacy: Airtable (superseded by Supabase; kept only in case Airtable
#     is revisited later — see src/lib/airtable.ts) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_SCHOLARSHIPS_TABLE=Scholarships
AIRTABLE_UNIVERSITIES_TABLE=Universities

# --- Analytics (not yet wired to a provider — see src/lib/analytics.ts) ---
# NEXT_PUBLIC_ANALYTICS_ID=

# --- Optional: silence a cosmetic Next.js dev warning ---
# Next 14.2.35 prints "Found lockfile missing swc dependencies ... Failed to patch
# lockfile" when package-lock.json lacks the SWC entries for your OS. The patch
# cannot succeed on this Next version (see README section 11e); it is harmless.
# Uncomment in your own .env.local to silence it.
# NEXT_IGNORE_INCORRECT_LOCKFILE=1
